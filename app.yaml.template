runtime: java11
env: flex

# ================================================================
# PLANTILLA DE CONFIGURACIÓN PARA APP ENGINE FLEXIBLE
#
# Instrucciones:
#   1. Copiar este archivo como: cp app.yaml.template app.yaml
#   2. Reemplazar todos los valores "TU_*" con los valores reales
#   3. NUNCA commitear app.yaml (ya está en .gitignore)
#   4. Para deployar: gcloud app deploy
# ================================================================

resources:
  cpu: 1
  memory_gb: 1.0
  disk_size_gb: 10

automatic_scaling:
  min_num_instances: 1
  max_num_instances: 3
  cool_down_period_sec: 120
  cpu_utilization:
    target_utilization: 0.7

env_variables:

  # Spring Boot: activa application-prod.properties
  SPRING_PROFILES_ACTIVE: "prod"

  # Base de datos Cloud SQL
  # Formato: jdbc:mysql://google/NOMBRE_DB?cloudSqlInstance=PROJECT:REGION:INSTANCIA&...
  SPRING_DATASOURCE_URL: "jdbc:mysql://google/economia_circular?cloudSqlInstance=TU_PROJECT_ID:TU_REGION:TU_INSTANCIA_SQL&socketFactory=com.google.cloud.sql.mysql.SocketFactory&useSSL=false&serverTimezone=UTC"
  SPRING_DATASOURCE_USERNAME: "TU_USUARIO_DB"
  SPRING_DATASOURCE_PASSWORD: "TU_PASSWORD_DB"

  # Email SMTP (Gmail App Password recomendado)
  EMAIL_ENABLED: "true"
  EMAIL_FROM: "no-reply@TU_DOMINIO.com"
  SMTP_HOST: "smtp.gmail.com"
  SMTP_PORT: "587"
  SMTP_USERNAME: "TU_CUENTA@gmail.com"
  SMTP_PASSWORD: "TU_APP_PASSWORD_GMAIL"

  # URLs para emails transaccionales
  PASSWORD_RESET_URL_BASE: "https://TU_FRONTEND.web.app/reset-password"
  EMAIL_VERIFY_URL_BASE: "https://TU_PROJECT_ID.appspot.com/api/auth/verify-email"
  EMAIL_VERIFICATION_REQUIRED: "true"

  # Límites de imágenes
  ARTICLE_IMAGES_MAX: "5"
  ARTICLE_IMAGES_MAX_SIZE_BYTES: "5242880"

beta_settings:
  cloud_sql_instances: "TU_PROJECT_ID:TU_REGION:TU_INSTANCIA_SQL"

handlers:
  - url: /.*
    script: auto
